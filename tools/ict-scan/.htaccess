# Apache/LiteSpeed: this directory's UI must not be embedded by another page.
# The release check must inspect the actual HTTP response after deployment.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # The ICT-scan HTML and organisation configuration must never outlive its JS release.
  <FilesMatch "^(index\.html|profile\.js|emmauscollege\.json)$">
    Header always set Cache-Control "no-store, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
